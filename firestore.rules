rules_version = '2';
// Cada pessoa só lê e grava o próprio documento (usuarios/{uid}). Nada mais pode ser lido ou gravado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
